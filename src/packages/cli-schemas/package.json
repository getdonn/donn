{
  "name": "@getdonn/cli-schemas",
  "version": "0.1.0",
  "private": true,
  "description": "zod schemas for the --json output of the donn CLI",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@getdonn/spec": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@getdonn/eslint-config": "workspace:*",
    "@getdonn/typescript-config": "workspace:*",
    "eslint": "10.13.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
