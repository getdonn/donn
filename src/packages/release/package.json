{
  "name": "@getdonn/release",
  "version": "0.0.0",
  "private": true,
  "description": "Release tooling: pack, smoke, publish and claim the @getdonn packages",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "donn-release": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@getdonn/eslint-config": "workspace:*",
    "@getdonn/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "10.13.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
