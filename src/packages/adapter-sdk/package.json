{
  "name": "@getdonn/adapter-sdk",
  "version": "0.6.0",
  "description": "The harness adapter contract, compile-report helpers and conformance kit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getdonn/donn.git",
    "directory": "src/packages/adapter-sdk"
  },
  "homepage": "https://getdonn.dev",
  "bugs": "https://github.com/getdonn/donn/issues",
  "keywords": [
    "donn",
    "persona",
    "ai-coding",
    "adapter",
    "conformance"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "default": "./dist/conformance/index.js"
    },
    "./conformance/vitest": {
      "types": "./dist/conformance/suite.d.ts",
      "default": "./dist/conformance/suite.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests --fsModuleCachePath node_modules/.vitest-cache",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "corpus:update": "node scripts/update-corpus.mjs"
  },
  "dependencies": {
    "@getdonn/spec": "workspace:*"
  },
  "devDependencies": {
    "@getdonn/eslint-config": "workspace:*",
    "@getdonn/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "10.13.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
