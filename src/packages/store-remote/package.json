{
  "name": "@getdonn/store-remote",
  "version": "0.5.4",
  "description": "The registry client: a verified cache of published layers, mounted ahead of the local store, and bundling for publish",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getdonn/donn.git",
    "directory": "src/packages/store-remote"
  },
  "homepage": "https://getdonn.dev",
  "bugs": "https://github.com/getdonn/donn/issues",
  "keywords": [
    "donn",
    "persona",
    "ai-coding",
    "registry",
    "store"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests --fsModuleCachePath node_modules/.vitest-cache",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@getdonn/registry-api": "workspace:*",
    "@getdonn/resolver": "workspace:*",
    "@getdonn/spec": "workspace:*",
    "@getdonn/store-local": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@getdonn/eslint-config": "workspace:*",
    "@getdonn/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "10.13.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
