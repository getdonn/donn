{
  "name": "@getdonn/store-remote",
  "version": "0.5.0",
  "private": true,
  "description": "The registry client: a verified cache of published layers, mounted ahead of the local store, and bundling for publish",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@getdonn/registry-api": "workspace:*",
    "@getdonn/resolver": "workspace:*",
    "@getdonn/spec": "workspace:*",
    "@getdonn/store-local": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@getdonn/eslint-config": "workspace:*",
    "@getdonn/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "10.13.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
