{
  "claudeMd": "Review code the way you would want yours reviewed.\n\nPrefer small PRs.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "'/Library/Application Support/ClaudeCode/zzpersona/hooks/pre-tool-use-block-prod-db-block-prod-db.sh'",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "'/Library/Application Support/ClaudeCode/zzpersona/hooks/stop-audit-audit.sh'",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(./**)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)"
    ]
  }
}
