{
  "name": "@getdonn/spec",
  "version": "0.3.1",
  "description": "Persona schema, resolved IR types, and validation",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getdonn/donn.git",
    "directory": "src/packages/spec"
  },
  "homepage": "https://getdonn.dev",
  "bugs": "https://github.com/getdonn/donn/issues",
  "keywords": [
    "donn",
    "persona",
    "ai-coding",
    "schema",
    "zod"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@getdonn/eslint-config": "workspace:*",
    "@getdonn/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "10.13.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
