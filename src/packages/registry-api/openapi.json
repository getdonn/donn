  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "LayerRef": {
        "type": "string",
        "pattern": "^(org|area|team)\\/[a-z0-9][a-z0-9-]*(\\/[a-z0-9][a-z0-9-]*)*$"
      },
      "BundleFile": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          }
        },
        "required": [
          "path",
          "content"
        ],
        "additionalProperties": false
      },
      "Whoami": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "org": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "session",
              "service"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "publish",
                    "lock"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "role",
                "path"
              ],
              "additionalProperties": false
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "subject",
          "org"
        ],
        "additionalProperties": false
      },
      "LayerSummary": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^(org|area|team)\\/[a-z0-9][a-z0-9-]*(\\/[a-z0-9][a-z0-9-]*)*$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "ref",
          "version",
          "digest"
        ],
        "additionalProperties": false
      },
      "LayerVersion": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^(org|area|team)\\/[a-z0-9][a-z0-9-]*(\\/[a-z0-9][a-z0-9-]*)*$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "source": {
