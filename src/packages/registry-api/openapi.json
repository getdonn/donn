    "/v1/managed/bundle": {
      "get": {
        "operationId": "managedBundle",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "layer",
            "in": "query",
            "required": true,
            "description": "The org/, area/ or team/ layer to build the managed bundle for.",
            "schema": {
              "$ref": "#/components/schemas/LayerRef"
            }
          },
          {
            "name": "os",
            "in": "query",
            "required": true,
            "description": "The operating system the bundle is for.",
            "schema": {
              "type": "string",
              "enum": [
                "macos",
                "linux",
                "windows"
              ]
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "The output format; `bundle` (the default) is required of every server, the others may answer 501.",
            "schema": {
              "type": "string",
              "enum": [
                "bundle",
                "console",
                "mobileconfig",
                "reg",
                "script-macos",
                "script-linux",
                "script-windows"
              ],
              "default": "bundle"
            }
          },
          {
            "name": "include",
            "in": "query",
            "required": false,
            "description": "For the script formats: `files` leaves out the settings drop-in.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "files"
              ],
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManagedBundleResponse"
                }
