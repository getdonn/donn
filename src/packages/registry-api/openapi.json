{
  "openapi": "3.1.0",
  "info": {
    "title": "zzpersona registry",
    "version": "0.1.0",
    "description": "Publish layers and pull exactly what was published. Generated from @zzpersona/registry-api."
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/v1/whoami": {
      "get": {
        "operationId": "whoami",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Whoami"
                }
              }
            }
          },
          "401": {
            "description": "Missing or refused token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Unknown ref or version",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "baseVersion is not the latest version",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The bundle or its place in the layer graph is refused",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/layers": {
      "get": {
        "operationId": "listLayers",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LayerSummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or refused token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Unknown ref or version",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "baseVersion is not the latest version",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The bundle or its place in the layer graph is refused",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/layers/{ref}/versions/{version}": {
      "get": {
        "operationId": "getVersion",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "description": "A layer ref such as team/web, URL-encoded as one path segment (team%2Fweb).",
            "schema": {
              "$ref": "#/components/schemas/LayerRef"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "description": "A version number, or `latest`.",
            "schema": {
              "type": "string",
              "pattern": "^([1-9][0-9]*|latest)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LayerVersion"
                }
              }
            }
          },
          "401": {
            "description": "Missing or refused token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Unknown ref or version",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "baseVersion is not the latest version",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The bundle or its place in the layer graph is refused",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/layers/{ref}/versions": {
      "post": {
        "operationId": "publish",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "description": "A layer ref such as team/web, URL-encoded as one path segment (team%2Fweb).",
            "schema": {
              "$ref": "#/components/schemas/LayerRef"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishResult"
                }
              }
            }
          },
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishResult"
                }
              }
            }
          },
          "401": {
            "description": "Missing or refused token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Unknown ref or version",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "baseVersion is not the latest version",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The bundle or its place in the layer graph is refused",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "LayerRef": {
        "type": "string",
        "pattern": "^(org|area|team)\\/[a-z0-9][a-z0-9-]*(\\/[a-z0-9][a-z0-9-]*)*$"
      },
      "BundleFile": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          }
        },
        "required": [
          "path",
          "content"
        ],
        "additionalProperties": false
      },
      "Whoami": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "org": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "subject",
          "org"
        ],
        "additionalProperties": false
      },
      "LayerSummary": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^(org|area|team)\\/[a-z0-9][a-z0-9-]*(\\/[a-z0-9][a-z0-9-]*)*$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "ref",
          "version",
          "digest"
        ],
        "additionalProperties": false
      },
      "LayerVersion": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^(org|area|team)\\/[a-z0-9][a-z0-9-]*(\\/[a-z0-9][a-z0-9-]*)*$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "source": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "content": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                }
              },
              "required": [
                "path",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "publishedBy": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ref",
          "version",
          "digest",
          "source",
          "files",
          "publishedAt",
          "publishedBy"
        ],
        "additionalProperties": false
      },
      "PublishRequest": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "content": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                }
              },
              "required": [
                "path",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "baseVersion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "dryRun": {
            "type": "boolean"
          },
          "force": {
            "type": "boolean"
          }
        },
        "required": [
          "source",
          "files",
          "baseVersion"
        ],
        "additionalProperties": false
      },
      "Change": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "change": {
            "type": "string",
            "enum": [
              "added",
              "removed",
              "changed"
            ]
          },
          "from": {},
          "to": {},
          "fromLayer": {
            "type": "string"
          },
          "toLayer": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "change"
        ],
        "additionalProperties": false
      },
      "PublishResult": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "broken": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(org|area|team)\\/[a-z0-9][a-z0-9-]*(\\/[a-z0-9][a-z0-9-]*)*$"
                }
              }
            },
            "required": [
              "version",
              "digest",
              "broken"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "unchanged": {
                "type": "boolean",
                "const": true
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "unchanged",
              "version",
              "digest"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "dryRun": {
                "type": "boolean",
                "const": true
              },
              "diff": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "change": {
                      "type": "string",
                      "enum": [
                        "added",
                        "removed",
                        "changed"
                      ]
                    },
                    "from": {},
                    "to": {},
                    "fromLayer": {
                      "type": "string"
                    },
                    "toLayer": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "change"
                  ],
                  "additionalProperties": false
                }
              },
              "broken": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(org|area|team)\\/[a-z0-9][a-z0-9-]*(\\/[a-z0-9][a-z0-9-]*)*$"
                }
              }
            },
            "required": [
              "dryRun",
              "diff",
              "broken"
            ],
            "additionalProperties": false
          }
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "detail": {
            "type": "string"
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "unauthorized",
                    "not-found",
                    "stale-base",
                    "invalid",
                    "not-publishable",
                    "missing-file",
                    "path-escapes-layer",
                    "bundle-too-large",
                    "unpublished-ancestor",
                    "lock-violation",
                    "breaks-descendants"
                  ]
                },
                "ref": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "additionalProperties": false
      }
    }
  }
}
