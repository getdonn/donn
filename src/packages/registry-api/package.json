{
  "name": "@zzpersona/registry-api",
  "version": "0.3.0",
  "private": true,
  "description": "The registry contract: schemas, routes, OpenAPI, a mock server and a conformance kit",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "default": "./dist/mock.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    }
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@zzpersona/resolver": "workspace:*",
    "@zzpersona/spec": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "vitest": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@zzpersona/eslint-config": "workspace:*",
    "@zzpersona/typescript-config": "workspace:*",
    "eslint": "10.13.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
