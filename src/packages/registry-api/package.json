{
  "name": "@getdonn/registry-api",
  "version": "0.6.0",
  "description": "The registry contract: schemas, routes, OpenAPI, a mock server and a conformance kit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getdonn/donn.git",
    "directory": "src/packages/registry-api"
  },
  "homepage": "https://getdonn.dev",
  "bugs": "https://github.com/getdonn/donn/issues",
  "keywords": [
    "donn",
    "persona",
    "ai-coding",
    "registry",
    "openapi"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "default": "./dist/mock.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    }
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@getdonn/adapter-sdk": "workspace:*",
    "@getdonn/resolver": "workspace:*",
    "@getdonn/spec": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "vitest": "^5.0.5"
  },
  "devDependencies": {
    "@getdonn/eslint-config": "workspace:*",
    "@getdonn/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "10.13.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
