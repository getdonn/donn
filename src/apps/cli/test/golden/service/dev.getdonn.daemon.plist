<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.getdonn.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/u/bin/donn</string>
		<string>daemon</string>
		<string>run</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/u/bin:/usr/bin</string>
		<key>DONN_HOME</key>
		<string>/h</string>
		<key>DONN_SERVICE</key>
		<string>1</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/h/daemon/daemon.log</string>
	<key>StandardErrorPath</key>
	<string>/h/daemon/daemon.log</string>
</dict>
</plist>
