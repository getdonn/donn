{
  "name": "@getdonn/cli",
  "version": "0.12.0",
  "description": "The donn command line",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getdonn/donn.git",
    "directory": "src/apps/cli"
  },
  "homepage": "https://getdonn.dev",
  "bugs": "https://github.com/getdonn/donn/issues",
  "keywords": [
    "donn",
    "persona",
    "ai-coding",
    "claude-code",
    "codex",
    "cli"
  ],
  "type": "module",
  "files": [
    "dist",
    "NOTICE",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@getdonn/adapter-agents-md": "workspace:*",
    "@getdonn/adapter-claude-code": "workspace:*",
    "@getdonn/adapter-codex": "workspace:*",
    "@getdonn/adapter-eve": "workspace:*",
    "@getdonn/adapter-sdk": "workspace:*",
    "@getdonn/executor": "workspace:*",
    "@getdonn/mod-claude-code": "workspace:*",
    "@getdonn/registry-api": "workspace:*",
    "@getdonn/resolver": "workspace:*",
    "@getdonn/secrets": "workspace:*",
    "@getdonn/spec": "workspace:*",
    "@getdonn/store-local": "workspace:*",
    "@getdonn/store-remote": "workspace:*",
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@getdonn/cli-schemas": "workspace:*",
    "@getdonn/eslint-config": "workspace:*",
    "@getdonn/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "10.13.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "bin": {
    "donn": "dist/bin.js"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
