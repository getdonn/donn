    "@zzpersona/spec": "workspace:*",
    "@zzpersona/store-local": "workspace:*",
    "@zzpersona/store-remote": "workspace:*",
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@zzpersona/eslint-config": "workspace:*",
    "@zzpersona/typescript-config": "workspace:*",
