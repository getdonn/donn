#!/usr/bin/env node
// Stands in for git in the e2e (see README.md): `ls-remote --tags <eve> <pattern>` lists the
// one tag the tests pin, eve@0.83.2. The UI tests use eve:blank and path templates, so no
// template tarball is fetched and this answers only donn's tag lookups.

const args = process.argv.slice(2);
if (args[0] === "ls-remote" && args[1] === "--tags") {
  process.stdout.write(`${"0".repeat(40)}\trefs/tags/eve@0.83.2\n`);
} else {
  process.stderr.write(`e2e git: unexpected ${args.join(" ")}\n`);
  process.exit(1);
}
