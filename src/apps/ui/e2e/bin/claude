#!/usr/bin/env node
// Stands in for Claude Code in the e2e (see README.md): only the `--version` probe the
// adapter's detection runs. Anything else fails loudly; never a real Claude Code.

const args = process.argv.slice(2);
if (args.length === 1 && args[0] === "--version") {
  process.stdout.write("2.1.306 (Claude Code)\n");
} else {
  process.stderr.write(`e2e claude: unexpected ${args.join(" ")}\n`);
  process.exit(1);
}
