{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "donn",
  "version": "../package.json",
  "identifier": "dev.getdonn.desktop",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
